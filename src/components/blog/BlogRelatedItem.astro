---
import { Picture } from 'astro:assets';
import { formatBlogDate, getBlogPostHref, type BlogEntry } from '../../lib/blog';

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const href = getBlogPostHref(post);
const imageAlt = post.data.imageAlt ?? post.data.title;
const imageTitle = post.data.imageTitle ?? post.data.title;
---

<a
  href={href}
  title={post.data.title}
  class="blog-related-item group flex gap-3 no-underline transition-opacity duration-200 hover:opacity-80"
>
  <div class="relative shrink-0 overflow-hidden rounded-xl">
    <Picture
      src={post.data.image}
      alt={imageAlt}
      title={imageTitle}
      formats={['avif', 'webp']}
      widths={[64, 128, 192]}
      sizes="(min-width: 640px) 72px, 64px"
      layout="constrained"
      class="size-16 object-cover transition-transform duration-300 group-hover:scale-[1.03] sm:size-[4.5rem]"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="min-w-0 flex-1 pt-0.5">
    <p
      class="text-black-500 line-clamp-2 text-sm leading-snug font-semibold tracking-tight"
    >
      {post.data.title}
    </p>
    <p class="text-black-400 mt-1.5 text-xs">
      {formatBlogDate(post.data.pubDate)}
    </p>
  </div>
</a>
