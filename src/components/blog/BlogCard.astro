---
import { Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import {
  formatBlogDate,
  getBlogPostHref,
  getBlogReadTime,
  type BlogEntry,
} from '../../lib/blog';
import './blog-card.scss';

interface Props {
  post: BlogEntry;
  class?: string;
}

const { post, class: className } = Astro.props;
const href = getBlogPostHref(post);
const readTime = getBlogReadTime(post);
const imageAlt = post.data.imageAlt ?? post.data.title;
const imageTitle = post.data.imageTitle ?? post.data.title;
---

<article class:list={['group flex h-full w-full', className]}>
  <a
    href={href}
    title={post.data.title}
    class="blog-card__link flex h-full w-full flex-col overflow-hidden rounded-3xl bg-white p-3 no-underline transition-shadow duration-200"
  >
    <div class="relative overflow-hidden rounded-2xl">
      <Picture
        src={post.data.image}
        alt={imageAlt}
        title={imageTitle}
        formats={['avif', 'webp']}
        widths={[400, 640, 800, 1200]}
        sizes="(max-width: 640px) 92vw, (max-width: 1024px) 44vw, 380px"
        layout="constrained"
        class="aspect-4/3 w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        loading="lazy"
        decoding="async"
      />
      <span
        class="blog-card__category absolute bottom-4 left-4 rounded-full px-3 py-1 text-xs font-semibold"
      >
        {post.data.category}
      </span>
    </div>

    <h3
      class="text-black-500 mt-3 line-clamp-2 min-h-13.5 px-1 text-lg leading-snug font-semibold tracking-tight text-balance sm:text-xl"
    >
      {post.data.title}
    </h3>

    <div
      class="text-black-400 mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 px-1 pb-1 text-sm"
    >
      <span class="inline-flex items-center gap-1.5">
        <Icon
          name="solar:calendar-minimalistic-linear"
          class="size-4"
          aria-hidden="true"
        />
        {formatBlogDate(post.data.pubDate)}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Icon
          name="solar:clock-circle-linear"
          class="size-4"
          aria-hidden="true"
        />
        {readTime}
      </span>
    </div>
  </a>
</article>
