---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import appIcon from '../assets/icon.png';
import { site } from '../data/site';
import {
  getNavbarLinkClasses,
  isNavbarPageActive,
} from './navbar/initNavbarActiveState';
import './navbar/navbar.scss';

const { pathname } = Astro.url;

type SectionNavLink = {
  label: string;
  href: string;
  section: string;
};

type PageNavLink = {
  label: string;
  href: string;
  page: string;
};

const navLinks: Array<SectionNavLink | PageNavLink> = [
  {
    label: 'Functionalitati',
    href: '/#manager-needs',
    section: 'manager-needs',
  },
  { label: 'Despre Noi', href: '/#why-us', section: 'why-us' },
  { label: 'Prețuri', href: '/#preturi', section: 'preturi' },
  { label: 'FAQ', href: '/#faq', section: 'faq' },
  { label: 'Contact', href: '/#contact', section: 'contact' },
  { label: 'Blog', href: '/blog', page: '/blog' },
];

const iconBtnClass =
  'navbar__icon-btn bg-black-50 text-black-500 hover:bg-black-100 flex size-9 items-center justify-center rounded-full';
const ctaClass =
  'navbar__cta bg-primary-500 text-white-500 hover:bg-primary-600 inline-flex items-center justify-center gap-1.5 rounded-full px-3.5 py-2.5 text-sm font-semibold whitespace-nowrap sm:px-5';
---

<header
  class="fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-6 sm:pt-5"
  data-nav-root
>
  <div
    class="navbar__backdrop"
    data-nav-backdrop
    hidden
    aria-hidden="true"
  >
  </div>

  <nav
    class="navbar bg-white-500 relative mx-auto flex max-w-6xl items-center justify-between gap-3 overflow-visible rounded-full px-4 py-2.5 shadow-[0_2px_24px_rgb(37_37_43/0.06)] sm:gap-4 sm:px-5"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="relative z-10 flex shrink-0 items-center gap-2.5 transition-opacity duration-200 hover:opacity-80"
    >
      <Image
        src={appIcon}
        alt="IziBook logo"
        aria-label="IziBook logo"
        title="IziBook logo"
        width={36}
        height={36}
        class="size-9 shrink-0 rounded-full"
        loading="eager"
      />
      <span class="text-black-500 text-xl font-black tracking-tight"
        >IziBook</span
      >
    </a>

    <ul class="hidden items-center gap-6 text-sm font-medium lg:flex xl:gap-7">
      {
        navLinks.map((link) => {
          const isActive =
            'page' in link
              ? isNavbarPageActive(pathname, link.page)
              : false;

          return (
            <li>
              <a
                href={link.href}
                data-nav-link
                {...('section' in link
                  ? { 'data-section': link.section }
                  : {})}
                {...('page' in link ? { 'data-page': link.page } : {})}
                class={getNavbarLinkClasses(isActive)}
                {...(isActive ? { 'aria-current': 'page' } : {})}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="z-10 flex shrink-0 items-center gap-1.5 sm:gap-2">
      <a
        href={site.apps.ios.url}
        target="_blank"
        rel="noopener noreferrer"
        class={iconBtnClass}
        aria-label="Download on the App Store"
      >
        <Icon name="ic:baseline-apple" class="size-6" />
      </a>
      <a
        href={site.apps.android.url}
        target="_blank"
        rel="noopener noreferrer"
        class={iconBtnClass}
        aria-label="Get it on Google Play"
      >
        <Icon name="uil:android" class="size-5" />
      </a>
      <div class="relative shrink-0">
        <span
          class="absolute -top-2.5 left-1/2 z-10 -translate-x-1/2 rounded-full bg-emerald-500 px-2 py-0.5 text-[0.625rem] font-bold tracking-wide text-white shadow-[0_2px_8px_rgb(16_185_129/0.35)]"
        >
          Nou
        </span>
        <a
          href={site.apps.web.url}
          target="_blank"
          rel="noopener noreferrer"
          class={ctaClass}
          aria-label="Deschide platforma web IziBook (link extern)"
        >
          <span class="sm:hidden">Web</span>
          <span class="hidden sm:inline">Platforma Web</span>
          <Icon
            name="solar:arrow-right-up-linear"
            class="size-4 shrink-0 opacity-95"
            aria-hidden="true"
          />
        </a>
      </div>

      <details class="navbar__mobile lg:hidden" data-nav-mobile>
        <summary
          class="navbar__toggle bg-black-50 text-black-500 hover:bg-black-100 flex size-10 list-none items-center justify-center rounded-full"
          aria-label="Deschide meniul"
        >
          <span class="navbar__toggle-bars" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </summary>

        <div class="navbar__panel" data-nav-panel>
          <div
            class="bg-white-500 overflow-hidden rounded-[1.75rem] p-3 shadow-[0_16px_48px_rgb(37_37_43/0.12)]"
          >
            <ul class="flex flex-col gap-0.5">
              {
                navLinks.map((link) => {
                  const isActive =
                    'page' in link
                      ? isNavbarPageActive(pathname, link.page)
                      : false;

                  return (
                    <li>
                      <a
                        href={link.href}
                        data-nav-link
                        {...('section' in link
                          ? { 'data-section': link.section }
                          : {})}
                        {...('page' in link ? { 'data-page': link.page } : {})}
                        class:list={[
                          'navbar__panel-link',
                          isActive && 'is-active',
                        ]}
                        {...(isActive ? { 'aria-current': 'page' } : {})}
                      >
                        {link.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </div>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  import { initNavbarActiveState } from './navbar/initNavbarActiveState';
  import {
    initNavbarMobile,
    initNavbarScroll,
  } from './navbar/initNavbarMenu';

  const cleanups: Array<() => void> = [];

  document.querySelectorAll<HTMLElement>('[data-nav-root]').forEach((root) => {
    cleanups.push(initNavbarActiveState(root));
    cleanups.push(initNavbarMobile(root));
    cleanups.push(initNavbarScroll(root));
  });

  document.addEventListener(
    'astro:before-swap',
    () => {
      cleanups.forEach((cleanup) => cleanup());
      cleanups.length = 0;
    },
    { once: true },
  );
</script>
