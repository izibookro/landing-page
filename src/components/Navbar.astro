---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import appIcon from '../assets/icon.png';
import { site } from '../data/site';
import {
  getNavbarLinkClasses,
  isNavbarPageActive,
} from './navbar/initNavbarActiveState';

const { pathname } = Astro.url;

type SectionNavLink = {
  label: string;
  href: string;
  section: string;
};

type PageNavLink = {
  label: string;
  href: string;
  page: string;
};

const navLinks: Array<SectionNavLink | PageNavLink> = [
  {
    label: 'Functionalitati',
    href: '/#manager-needs',
    section: 'manager-needs',
  },
  { label: 'Despre Noi', href: '/#why-us', section: 'why-us' },
  { label: 'Prețuri', href: '/#preturi', section: 'preturi' },
  { label: 'FAQ', href: '/#faq', section: 'faq' },
  { label: 'Contact', href: '/#contact', section: 'contact' },
  { label: 'Blog', href: '/blog', page: '/blog' },
];
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-5 sm:px-6" data-nav-root>
  <nav
    class="bg-white-500 mx-auto flex max-w-6xl items-center justify-between gap-4 overflow-visible rounded-full px-4 py-2.5 shadow-[0_2px_24px_rgb(37_37_43/0.06)] sm:px-5"
    aria-label="Main navigation"
  >
    <!-- Brand -->
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <Image
        src={appIcon}
        alt="IziBook logo"
        aria-label="IziBook logo"
        title="IziBook logo"
        width={36}
        height={36}
        class="size-9 shrink-0 rounded-full"
        loading="eager"
      />
      <span class="text-black-500 text-xl font-black tracking-tight"
        >IziBook</span
      >
    </a>

    <!-- Links -->
    <ul
      class="hidden items-center gap-7 text-sm font-medium md:flex"
    >
      {
        navLinks.map((link) => {
          const isActive =
            'page' in link
              ? isNavbarPageActive(pathname, link.page)
              : false;

          return (
            <li>
              <a
                href={link.href}
                data-nav-link
                {...('section' in link
                  ? { 'data-section': link.section }
                  : {})}
                {...('page' in link ? { 'data-page': link.page } : {})}
                class={getNavbarLinkClasses(isActive)}
                {...(isActive ? { 'aria-current': 'page' } : {})}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- Store buttons -->
    <div class="flex shrink-0 items-center gap-2">
      <a
        href={site.apps.ios.url}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-black-50 text-black-500 hover:bg-black-100 flex size-9 items-center justify-center rounded-full transition-colors duration-200"
        aria-label="Download on the App Store"
      >
        <Icon name="ic:baseline-apple" class="size-6" />
      </a>
      <a
        href={site.apps.android.url}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-black-50 text-black-500 hover:bg-black-100 flex size-9 items-center justify-center rounded-full transition-colors duration-200"
        aria-label="Get it on Google Play"
      >
        <Icon name="uil:android" class="size-5" />
      </a>
      <div class="relative shrink-0">
        <span
          class="absolute -top-2.5 left-1/2 z-10 -translate-x-1/2 rounded-full bg-emerald-500 px-2 py-0.5 text-[0.625rem] font-bold tracking-wide text-white shadow-[0_2px_8px_rgb(16_185_129/0.35)]"
        >
          Nou
        </span>
        <a
          href={site.apps.web.url}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-primary-500 text-white-500 hover:bg-primary-600 inline-flex items-center justify-center gap-1.5 rounded-full px-5 py-2.5 text-sm font-semibold whitespace-nowrap transition-colors duration-200"
          aria-label="Deschide platforma web IziBook (link extern)"
        >
          Platforma Web
          <Icon
            name="solar:arrow-right-up-linear"
            class="size-4 shrink-0 opacity-95"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </nav>
</header>

<script>
  import { initNavbarActiveState } from './navbar/initNavbarActiveState';

  const cleanups: Array<() => void> = [];

  document.querySelectorAll<HTMLElement>('[data-nav-root]').forEach((root) => {
    cleanups.push(initNavbarActiveState(root));
  });

  document.addEventListener(
    'astro:before-swap',
    () => {
      cleanups.forEach((cleanup) => cleanup());
      cleanups.length = 0;
    },
    { once: true },
  );
</script>
