---
import { Icon } from 'astro-icon/components';
import { faqHomeItems } from '../../data/faqItems';
import './faq-section.scss';
---

<section
  id="faq"
  class="bg-white-500 relative px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="faq-heading"
  data-faq-root
>
  <div class="mx-auto max-w-6xl">
    <div
      class="grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:items-start lg:gap-12"
    >
      <aside class="lg:sticky lg:top-28">
        <div class="text-left">
          <h2
            id="faq-heading"
            class="text-black-500 text-[clamp(2.125rem,5.4vw,4rem)] leading-[1.1] font-semibold tracking-[-0.038em] text-balance"
          >
            Intrebari
            <span class="faq-section__heading-fade">frecvente</span>
          </h2>
          <p
            class="text-black-400 mt-4 max-w-2xl text-[clamp(0.9375rem,2.2vw,1.0625rem)] leading-relaxed text-balance"
          >
            Raspunsuri rapide la cele mai comune intrebari. Lista completa e pe
            pagina de FAQ.
          </p>
          <p class="mt-4">
            <a
              href="/faq"
              title="Toate intrebarile frecvente IziBook"
              class="text-black-500 text-sm font-semibold underline decoration-primary-300 underline-offset-4"
            >
              Vezi toate intrebarile
            </a>
          </p>
        </div>

        <div
          class="faq-cta-card mt-8 rounded-3xl p-6 shadow-[0_12px_40px_rgb(37_37_43/0.06)] sm:mt-10 sm:p-8"
        >
          <p class="text-black-500 text-xl font-semibold tracking-tight">
            Mai ai intrebari?
          </p>
          <p class="text-black-400 mt-2 text-sm leading-relaxed">
            Contacteaza-ne pentru mai multe informatii sau pentru o demonstratie
            personalizata.
          </p>
          <a
            href="/contact"
            title="Contacteaza echipa IziBook"
            class="bg-black-500 text-white-500 hover:bg-black-600 mt-6 inline-flex items-center justify-center rounded-full px-7 py-3.5 text-sm font-semibold transition-colors duration-200"
          >
            Contacteaza-ne
          </a>
        </div>
      </aside>

      <div class="divide-black-100 divide-y">
        {
          faqHomeItems.map((item, index) => (
            <details
              class:list={['faq-item', 'group', index === 0 && 'is-open']}
              open
            >
              <summary
                class="flex cursor-pointer items-start justify-between gap-4 py-5 text-left"
                aria-expanded={index === 0 ? 'true' : 'false'}
              >
                <span class="text-black-500 text-base font-semibold sm:text-[1.0625rem]">
                  {item.question}
                </span>
                <Icon
                  name="solar:alt-arrow-down-linear"
                  class="faq-item__chevron text-black-400 mt-0.5 size-5 shrink-0"
                  aria-hidden="true"
                />
              </summary>
              <div
                class="faq-item__panel"
                aria-hidden={index === 0 ? 'false' : 'true'}
              >
                <div class="faq-item__panel-inner">
                  <p class="faq-item__answer text-black-400 pb-5 text-sm leading-relaxed sm:text-[0.9375rem]">
                    {item.answer}
                    {item.link && (
                      <>
                        {' '}
                        <a
                          href={item.link.href}
                          title={item.link.title}
                          class="text-black-500 font-semibold underline decoration-primary-300 underline-offset-4"
                        >
                          {item.link.label}
                        </a>
                        .
                      </>
                    )}
                  </p>
                </div>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initFaqAccordion } from './initFaqAccordion';

  const cleanups: Array<() => void> = [];

  document.querySelectorAll<HTMLElement>('[data-faq-root]').forEach((root) => {
    cleanups.push(initFaqAccordion(root));
  });

  document.addEventListener(
    'astro:before-swap',
    () => {
      cleanups.forEach((cleanup) => cleanup());
      cleanups.length = 0;
    },
    { once: true },
  );
</script>
