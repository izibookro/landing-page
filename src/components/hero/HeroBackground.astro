<div
  class="bg-white-500 pointer-events-none absolute inset-0 overflow-hidden"
  aria-hidden="true"
>
  <div id="hero-particles" class="absolute inset-0 h-full w-full"></div>
</div>

<script>
  import { whenIdle } from '../../lib/deferWork';

  whenIdle(() => {
    void import('./initHeroParticles').then(({ initHeroParticles }) =>
      initHeroParticles().catch((error: unknown) => {
        console.error('Failed to initialize hero particles:', error);
      }),
    );
  });
</script>
