---
import { Icon } from 'astro-icon/components';
import HeroMockups from './HeroMockups.astro';
---

<section class="relative grid h-dvh grid-rows-[auto_minmax(0,1fr)] overflow-hidden">
  <div
    class="relative z-10 mx-auto flex max-w-4xl shrink-0 flex-col items-center px-4 pt-20 pb-10 text-center sm:px-6 sm:pt-24 lg:pt-28"
  >
    <!-- Headline -->
    <h1
      class="text-black-500 max-w-3xl text-4xl leading-[1.1] font-bold tracking-tight sm:text-5xl lg:text-[3.5rem]"
    >
      Revolutionam industria frumusetii prin tehnologie.
    </h1>

    <!-- Subheadline -->
    <p
      class="text-black-400 mt-5 max-w-2xl text-base leading-relaxed sm:text-lg"
    >
      Un singur sistem, toate platformele. Totul intr-un singur loc. Accesibil
      de pe orice dispozitiv.
    </p>

    <!-- CTAs -->
    <div
      class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center"
    >
      <a
        href="#start"
        class="bg-primary-500 text-white-500 hover:bg-primary-600 inline-flex items-center justify-center rounded-full px-7 py-3.5 text-sm font-semibold transition-colors duration-200"
      >
        Incepe gratuit
      </a>

      <a
        href="#demo"
        class="border-black-100 bg-white-500 text-black-500 inline-flex items-center justify-center gap-2 rounded-full border px-7 py-3.5 text-sm font-semibold shadow-[0_2px_16px_rgb(37_37_43/0.06)] transition-shadow duration-200 hover:shadow-[0_4px_24px_rgb(37_37_43/0.1)]"
      >
        <span
          class="bg-black-500 text-white-500 flex size-6 items-center justify-center rounded-full"
        >
          <Icon name="solar:play-bold" class="size-3" />
        </span>
        Vezi demo
      </a>
    </div>
  </div>

  <div class="relative h-full min-h-0 overflow-hidden">
    <HeroMockups />
  </div>
</section>
