---
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';
import HeroBackground from './HeroBackground.astro';
import HeroMockups from './HeroMockups.astro';
---

<section
  class="relative grid h-dvh grid-rows-[auto_minmax(0,1fr)] overflow-hidden"
>
  <HeroBackground />

  <div
    class="relative z-10 mx-auto flex max-w-4xl shrink-0 flex-col items-center px-4 pt-20 pb-10 text-center sm:px-6 sm:pt-24 lg:pt-28"
  >
    <!-- Headline -->
    <h1
      class="text-black-500 max-w-4xl text-4xl leading-[1.1] font-bold tracking-tight sm:text-5xl lg:text-7xl"
    >
      Revolutionam industria frumusetii prin tehnologie.
    </h1>

    <!-- Subheadline -->
    <p
      class="text-black-400 mt-5 max-w-xl text-base leading-relaxed sm:text-lg"
    >
      Un singur sistem, toate platformele. Totul intr-un singur loc. Accesibil
      de pe orice dispozitiv.
    </p>

    <p class="text-black-400 mt-2 max-w-2xl text-sm leading-relaxed italic">
      "Un singur sistem sa le conduca pe toate"
    </p>

    <!-- CTAs -->
    <div
      class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center"
    >
      <a
        href={site.apps.web.onboarding}
        target="_blank"
        rel="noopener noreferrer"
        class="bg-primary-500 text-white-500 hover:bg-primary-600 inline-flex items-center justify-center rounded-full px-7 py-3.5 text-sm font-semibold transition-colors duration-200"
      >
        Incepe gratuit
      </a>

      <a
        href="#demo"
        class="text-black-500 inline-flex items-center justify-center gap-2.5 rounded-full bg-white px-6 py-3.5 text-[0.9375rem] font-semibold shadow-[0_2px_16px_rgb(37_37_43/0.08)] transition-[box-shadow,transform] duration-200 hover:-translate-y-px hover:shadow-[0_4px_24px_rgb(37_37_43/0.12)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      >
        <span
          class="bg-black-500 text-white-500 flex size-6 items-center justify-center rounded-full"
        >
          <Icon name="solar:play-bold" class="size-3" />
        </span>
        Vezi demo
      </a>
    </div>
  </div>

  <div class="relative z-10 h-full min-h-0 overflow-visible">
    <HeroMockups />
  </div>
</section>
