---
import type { ImageMetadata } from 'astro';
import mockupCenter from '../../assets/mockups/mockup-1.png';
import mockupLeft from '../../assets/mockups/mockup-2.png';
import mockupRight from '../../assets/mockups/mockup-3.png';
import PhoneFrame from '../PhoneFrame.astro';

interface MockupConfig {
  src: ImageMetadata;
  alt: string;
  wrapper: string;
}

const mockups: MockupConfig[] = [
  {
    src: mockupLeft,
    alt: 'Izibook schedule view',
    wrapper:
      'z-10 h-[88%] origin-bottom -mr-14 -rotate-[16deg] sm:-mr-20 sm:-rotate-[20deg] lg:-mr-28 lg:-rotate-[20deg]',
  },
  {
    src: mockupCenter,
    alt: 'Izibook dashboard overview',
    wrapper: 'z-20 h-full origin-bottom',
  },
  {
    src: mockupRight,
    alt: 'Izibook booking screen',
    wrapper:
      'z-10 h-[88%] origin-bottom -ml-14 rotate-[16deg] sm:-ml-20 sm:rotate-[20deg] lg:-ml-28 lg:rotate-[20deg]',
  },
];
---

<div class="relative h-full min-h-0 overflow-hidden">
  <div
    class="flex h-full min-h-0 items-end justify-center overflow-hidden"
    aria-hidden="true"
  >
    {
      mockups.map((mockup) => (
        <div
          class:list={['pointer-events-none relative shrink-0', mockup.wrapper]}
        >
          <div class="aspect-[9/8] h-full overflow-hidden">
            <PhoneFrame
              src={mockup.src}
              alt={mockup.alt}
              class="h-full w-full object-cover object-top"
            />
          </div>
        </div>
      ))
    }
  </div>

  <div
    class="from-white-500 via-white-500/90 pointer-events-none absolute inset-x-0 bottom-0 z-10 h-16 bg-linear-to-t to-transparent"
    aria-hidden="true"
  >
  </div>
</div>
