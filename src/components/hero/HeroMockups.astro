---
import type { ImageMetadata } from 'astro';
import mockupCenter from '../../assets/mockups/mockup-1.png';
import mockupLeft from '../../assets/mockups/mockup-2.png';
import mockupRight from '../../assets/mockups/mockup-3.png';
import PhoneFrame from '../PhoneFrame.astro';

type MockupRole = 'left' | 'center' | 'right';

interface MockupConfig {
  src: ImageMetadata;
  alt: string;
  role: MockupRole;
  wrapper: string;
}

const mockups: MockupConfig[] = [
  {
    src: mockupLeft,
    alt: 'IziBook schedule view',
    role: 'left',
    wrapper:
      'mockup-phone mockup-phone--side z-10 origin-bottom -mr-8 -rotate-[12deg] sm:-mr-16 sm:-rotate-[18deg] lg:-mr-28 lg:-rotate-[20deg]',
  },
  {
    src: mockupCenter,
    alt: 'IziBook dashboard overview',
    role: 'center',
    wrapper: 'mockup-phone mockup-phone--center z-30 origin-bottom',
  },
  {
    src: mockupRight,
    alt: 'IziBook booking screen',
    role: 'right',
    wrapper:
      'mockup-phone mockup-phone--side z-10 origin-bottom -ml-8 rotate-[12deg] sm:-ml-16 sm:rotate-[18deg] lg:-ml-28 lg:rotate-[20deg]',
  },
];
---

<div class="relative h-full min-h-0 overflow-hidden">
  <div
    class="mockup-stage flex h-full min-h-0 items-end justify-center overflow-hidden pt-1 sm:pt-5"
    aria-hidden="true"
  >
    <div class="mockup-cluster flex items-end justify-center">
      {
        mockups.map((mockup) => (
          <div
            class:list={['pointer-events-none relative shrink-0', mockup.wrapper]}
          >
            <div
              class:list={[
                'mockup-motion relative h-full w-full',
                `mockup-motion--${mockup.role}`,
                mockup.role === 'center' ? 'z-20' : 'z-10',
              ]}
            >
              <div class="mockup-frame aspect-9/8 overflow-hidden">
                <PhoneFrame
                  src={mockup.src}
                  alt={mockup.alt}
                  class="h-full w-full object-cover object-top"
                />
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div
    class="from-white-500 via-white-500/90 pointer-events-none absolute inset-x-0 bottom-0 z-20 h-10 bg-linear-to-t to-transparent sm:h-16"
    aria-hidden="true"
  >
  </div>
</div>

<style>
  /* Mobile / tablet: compact width-driven phones under the copy */
  .mockup-stage {
    isolation: isolate;
    height: auto;
    min-height: 13rem;
  }

  .mockup-cluster {
    width: min(100%, 26rem);
    height: auto;
  }

  .mockup-phone--center {
    width: 50%;
  }

  .mockup-phone--side {
    width: 42%;
  }

  .mockup-frame {
    width: 100%;
    height: auto;
  }

  @media (min-width: 640px) {
    .mockup-stage {
      min-height: 18rem;
    }

    .mockup-cluster {
      width: min(100%, 34rem);
    }
  }

  /* Desktop: fill remaining hero row */
  @media (min-width: 1024px) {
    .mockup-stage {
      height: 100%;
      min-height: 0;
      container-type: size;
    }

    .mockup-cluster {
      width: auto;
      height: 100%;
    }

    .mockup-phone--side {
      width: auto;
      height: 88%;
    }

    .mockup-phone--center {
      width: auto;
      height: 100%;
    }

    .mockup-frame {
      width: auto;
      height: 100%;
    }
  }

  .mockup-motion {
    opacity: 0;
    will-change: transform, opacity;
  }

  .mockup-motion--left {
    animation:
      mockup-enter-left 1s cubic-bezier(0.22, 1, 0.36, 1) 0.08s forwards,
      mockup-float-left 4.8s ease-in-out 1.35s infinite;
  }

  .mockup-motion--center {
    animation:
      mockup-enter-center 1.05s cubic-bezier(0.34, 1.35, 0.64, 1) 0.32s forwards,
      mockup-float-center 5.2s ease-in-out 1.6s infinite;
  }

  .mockup-motion--right {
    animation:
      mockup-enter-right 1s cubic-bezier(0.22, 1, 0.36, 1) 0.16s forwards,
      mockup-float-right 4.6s ease-in-out 1.45s infinite;
  }

  @keyframes mockup-enter-left {
    0% {
      opacity: 0;
      transform: translate3d(-1.25rem, 3.5rem, 0) scale(0.92);
    }

    55% {
      opacity: 1;
    }

    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes mockup-enter-right {
    0% {
      opacity: 0;
      transform: translate3d(1.25rem, 3.5rem, 0) scale(0.92);
    }

    55% {
      opacity: 1;
    }

    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes mockup-enter-center {
    0% {
      opacity: 0;
      transform: translate3d(0, 4.5rem, 0) scale(0.88);
    }

    70% {
      opacity: 1;
      transform: translate3d(0, -0.35rem, 0) scale(1.02);
    }

    100% {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes mockup-float-left {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(0, -0.45rem, 0);
    }
  }

  @keyframes mockup-float-center {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    50% {
      transform: translate3d(0, -0.65rem, 0) scale(1.008);
    }
  }

  @keyframes mockup-float-right {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }

    50% {
      transform: translate3d(0, -0.4rem, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mockup-motion {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
