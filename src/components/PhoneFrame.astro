---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}

const { src, alt, class: className } = Astro.props;
---

<Image
  src={src}
  alt={alt}
  class:list={['block', className]}
  loading="eager"
/>
