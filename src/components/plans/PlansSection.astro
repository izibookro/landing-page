---
import { Icon } from 'astro-icon/components';
import { plans } from '../../data/plans';
import './plans-section.scss';
---

<section
  id="preturi"
  class="plans-section bg-white-500 relative overflow-hidden px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="plans-heading"
>
  <div class="pointer-events-none absolute inset-0 z-1" aria-hidden="true">
    <div id="plans-particles" class="absolute inset-0 h-full w-full"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="mx-auto max-w-3xl text-center">
      <h2
        id="plans-heading"
        class="text-black-500 text-[clamp(2.125rem,5.4vw,4rem)] leading-[1.1] font-semibold tracking-[-0.038em] text-balance"
      >
        Planuri
        <span class="plans-section__heading-fade">flexibile</span>
      </h2>
      <p
        class="text-black-400 mx-auto mt-4 max-w-2xl text-[clamp(0.9375rem,2.2vw,1.0625rem)] leading-relaxed text-balance"
      >
        Alege pachetul potrivit pentru dimensiunea echipei tale. Fara costuri
        ascunse, fara limite, fara taxe suplimentare.
      </p>
    </div>

    <div
      class="mt-10 grid gap-4 sm:mt-12 sm:gap-5 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        plans.map((plan) => (
          <article
            class="plans-card from-white-700 via-black-50 to-black-100 bg-linear-to-br from-0% via-42% to-100%"
            aria-label={plan.name}
          >
            <div class="plans-card__header">
              <div class="flex items-start justify-between gap-4">
                <Icon
                  name={plan.icon}
                  class="text-black-500 size-8 shrink-0"
                  aria-hidden="true"
                />
                <div class="text-right">
                  <p class="plans-card__price text-black-500 text-[clamp(1.5rem,3vw,1.875rem)] leading-tight font-bold">
                    {plan.price}
                    <span class="text-black-400 text-base font-medium">
                      {' '}
                      RON
                    </span>
                    <span class="text-black-400 text-sm font-medium">
                      {' '}
                      / pe luna
                    </span>
                  </p>
                </div>
              </div>

              <div class="mt-5 flex flex-wrap items-center gap-2">
                <h3 class="text-black-500 text-xl font-semibold tracking-tight">
                  {plan.name}
                </h3>
                {plan.popular && <span class="plans-card__badge">Popular</span>}
              </div>
              <p class="text-black-400 mt-2 text-sm leading-relaxed">
                {plan.description}
              </p>
            </div>

            <div class="plans-card__features">
              <p class="text-black-500 mb-1 text-sm font-semibold">
                Functionalitati incluse:
              </p>
              <ul class="list-none">
                {plan.features.map((feature) => (
                  <li class="plans-card__feature">
                    <Icon
                      name="solar:check-circle-bold"
                      class="plans-card__check size-4.5"
                      aria-hidden="true"
                    />
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="plans-card__footer">
              <a
                href="#contact"
                class:list={[
                  'inline-flex w-full items-center justify-center rounded-full',
                  plan.popular
                    ? 'bg-primary-500 text-white-500 hover:bg-primary-600 px-7 py-3.5 text-sm font-semibold transition-colors duration-200'
                    : 'text-black-500 focus-visible:outline-primary-500 bg-white px-6 py-3.5 text-[0.9375rem] font-semibold shadow-[0_2px_16px_rgb(37_37_43/0.08)] transition-[box-shadow,transform] duration-200 hover:-translate-y-px hover:shadow-[0_4px_24px_rgb(37_37_43/0.12)] focus-visible:outline-2 focus-visible:outline-offset-2',
                ]}
              >
                Incepe acum
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initPlansParticles } from './initPlansParticles';

  initPlansParticles().catch((error: unknown) => {
    console.error('Failed to initialize plans particles:', error);
  });
</script>
