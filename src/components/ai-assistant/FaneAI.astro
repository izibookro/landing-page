---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import faneIllustration from '../../assets/illustrations/fane.webp';
import { site } from '../../data/site';

interface Props {
  showHeading?: boolean;
}

const { showHeading = true } = Astro.props;

const promptBubbles = [
  'Ce servicii are Iulia?',
  'Ce locuri libere sunt maine la Marius?',
  'Cat costa un balayage la Ioana?',
];
---

<section
  id="fane-ai"
  class="bg-white-500 relative overflow-x-hidden px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="fane-ai-heading"
>
  <div class="mx-auto max-w-6xl">
    {
      showHeading ? (
        <div class="mx-auto max-w-6xl text-center">
          <h2 id="fane-ai-heading" class="fane-ai-heading">
            Fa cunostinta cu <span class="fane-ai-heading__brand">Fane</span>,
            <br />
            <span class="fane-ai-heading__fade">Asistentul tau Inteligent</span>
          </h2>
          <p class="text-black-400 sm:text-l mx-auto mt-4 max-w-xl text-base leading-relaxed">
            Cel mai simplu si rapid mod pentru clienti sa se programeze. Discuta
            pe <strong>WhatsApp</strong> cu Fane la orice ora. El te
            programeaza, te tine la curent cu disponibilitatea unui angajat sau
            pretul unui serviciu.
          </p>
        </div>
      ) : (
        <h2 id="fane-ai-heading" class="sr-only">
          Fane AI, asistentul inteligent IziBook
        </h2>
      )
    }

    <!-- Visual area -->
    <div class:list={['fane-ai__stage', showHeading ? 'mt-12 sm:mt-16' : '']}>
      <div class="fane-ai__glow" aria-hidden="true">
        <div class="fane-ai__arcs">
          <span class="fane-ai__ring fane-ai__ring--1 bg-primary-500/65"></span>
          <span class="fane-ai__ring fane-ai__ring--2 bg-primary-400/75"></span>
          <span class="fane-ai__ring fane-ai__ring--3 bg-primary-300/80"></span>
          <span class="fane-ai__ring fane-ai__ring--4 bg-primary-200/70"></span>
          <span class="fane-ai__ring fane-ai__ring--5 bg-primary-100/60"></span>
        </div>
      </div>

      <!-- Left: prompt bubbles + CTA -->
      <div class="fane-ai__left">
        <ul class="fane-ai__bubbles" aria-label="Exemple de intrebari">
          {promptBubbles.map((text) => <li class="fane-ai__bubble">{text}</li>)}
        </ul>

        <a
          href={site.apps.web.onboarding}
          target="_blank"
          rel="noopener noreferrer"
          title="Incepe gratuit cu IziBook"
          class="bg-primary-700 text-white-500 hover:bg-primary-800 fane-ai__cta inline-flex items-center justify-center rounded-full px-7 py-3.5 text-sm font-semibold transition-colors duration-200"
        >
          Incepe gratuit
        </a>
        {
          showHeading && (
            <a
              href="/fane-ai"
              title="Cum functioneaza Fane AI"
              class="text-black-500 self-center text-center text-sm font-semibold underline decoration-primary-300 underline-offset-4"
            >
              Cum functioneaza Fane
            </a>
          )
        }
      </div>

      <!-- Center: illustration -->
      <div class="fane-ai__center">
        <Image
          src={faneIllustration}
          alt="Fane AI — asistent inteligent pentru salon"
          title="Fane AI — asistent inteligent IziBook pentru programari pe WhatsApp"
          format="webp"
          widths={[272, 352, 416, 832]}
          sizes="(min-width: 1024px) 26rem, (min-width: 640px) 22rem, 17rem"
          class="fane-ai__illustration"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Right: chat card -->
      <div class="fane-ai__chat">
        <div class="fane-ai__chat-card">
          <div class="fane-ai__message fane-ai__message--ai">
            <p>
              Buna! Sunt Fane, asistentul tau. Ce serviciu cauti astazi? (Promit
              sa fiu mai rapid decat un story.)
            </p>
          </div>

          <div class="fane-ai__message fane-ai__message--user">
            <p>Vreau sa ma tund la Marius</p>
          </div>

          <div class="fane-ai__message fane-ai__message--ai">
            <p class="whitespace-pre-line">
              {
                `Iata serviciile disponibile cu Marius:
1) Tuns Barbati - 130 RON, 30 min
2) Tuns Barbati cu Barba - 150 RON, 45 min

Cand doresti sa te programezi?`
              }
            </p>
          </div>

          <div class="fane-ai__chat-footer">
            <button
              type="button"
              class="fane-ai__stop-btn"
              disabled
              aria-label="Opreste generarea"
            >
              <Icon name="solar:stop-circle-bold" class="size-4" />
              Opreste generarea...
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .fane-ai-heading {
    margin-inline: auto;
    margin-bottom: 0;
    max-width: 18em;
    text-wrap: balance;
    font-size: clamp(2.125rem, 5.4vw, 4rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.038em;
    color: rgb(37 37 43);
  }

  .fane-ai-heading__brand {
    color: rgb(234 88 12);
  }

  .fane-ai-heading__fade {
    background: linear-gradient(
      168deg,
      rgb(37 37 43) 0%,
      rgb(106 106 114) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (min-width: 640px) {
    .fane-ai-heading {
      max-width: 19em;
    }
  }

  .fane-ai__stage {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .fane-ai__stage {
      grid-template-columns: 1fr auto 1fr;
      gap: 1.5rem;
      min-height: 28rem;
    }
  }

  .fane-ai__glow {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }

  .fane-ai__arcs {
    position: relative;
    width: min(100%, 50rem);
    height: 22rem;
    overflow: hidden;
  }

  .fane-ai__arcs::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 70%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgb(255 255 255 / 0.55) 45%,
      rgb(255 255 255) 100%
    );
    pointer-events: none;
    z-index: 1;
  }

  @media (min-width: 640px) {
    .fane-ai__arcs {
      width: min(100%, 58rem);
      height: 26rem;
    }
  }

  @media (min-width: 1024px) {
    .fane-ai__arcs {
      width: 68rem;
      height: 30rem;
    }
  }

  .fane-ai__ring {
    position: absolute;
    left: 50%;
    bottom: 0;
    border-radius: 50%;
    transform: translate(-50%, 50%);
  }
  .fane-ai__left,
  .fane-ai__center,
  .fane-ai__chat {
    position: relative;
    z-index: 1;
  }

  /* Left column */
  .fane-ai__left {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    order: 2;
  }

  @media (min-width: 1024px) {
    .fane-ai__left {
      order: 0;
      align-items: flex-start;
      justify-content: center;
      padding-right: 0.5rem;
    }
  }

  .fane-ai__bubbles {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .fane-ai__bubble {
    max-width: 16rem;
    margin-left: 1.25rem;
    border-radius: 1rem;
    padding: 0.875rem 1.125rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgb(37 37 43);
    background: rgb(255 255 255);
    box-shadow: 0 4px 14px rgb(37 37 43 / 0.08);
  }

  .fane-ai__bubble:nth-child(2) {
    margin-left: 2.75rem;
  }

  .fane-ai__bubble:nth-child(3) {
    margin-left: 2rem;
  }

  @media (min-width: 1024px) {
    .fane-ai__bubble {
      margin-left: 2rem;
    }

    .fane-ai__bubble:nth-child(2) {
      margin-left: 4.5rem;
    }

    .fane-ai__bubble:nth-child(3) {
      margin-left: 3rem;
    }
  }

  .fane-ai__cta {
    align-self: center;
  }

  /* Center illustration */
  .fane-ai__center {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    order: 1;
    min-height: 22rem;
    overflow: visible;
  }

  @media (min-width: 1024px) {
    .fane-ai__center {
      order: 0;
      min-height: 28rem;
      width: 28rem;
    }
  }

  .fane-ai__ring--1 {
    width: 20rem;
    height: 20rem;
    opacity: 1;
  }

  .fane-ai__ring--2 {
    width: 26rem;
    height: 26rem;
    opacity: 0.98;
  }

  .fane-ai__ring--3 {
    width: 32rem;
    height: 32rem;
    opacity: 0.96;
  }

  .fane-ai__ring--4 {
    width: 38rem;
    height: 38rem;
    opacity: 0.93;
  }

  .fane-ai__ring--5 {
    width: 44rem;
    height: 44rem;
    opacity: 0.9;
  }

  @media (min-width: 640px) {
    .fane-ai__ring--1 {
      width: 22rem;
      height: 22rem;
    }

    .fane-ai__ring--2 {
      width: 29rem;
      height: 29rem;
    }

    .fane-ai__ring--3 {
      width: 36rem;
      height: 36rem;
    }

    .fane-ai__ring--4 {
      width: 43rem;
      height: 43rem;
    }

    .fane-ai__ring--5 {
      width: 50rem;
      height: 50rem;
    }
  }

  @media (min-width: 1024px) {
    .fane-ai__ring--1 {
      width: 24rem;
      height: 24rem;
    }

    .fane-ai__ring--2 {
      width: 33rem;
      height: 33rem;
    }

    .fane-ai__ring--3 {
      width: 42rem;
      height: 42rem;
    }

    .fane-ai__ring--4 {
      width: 51rem;
      height: 51rem;
    }

    .fane-ai__ring--5 {
      width: 60rem;
      height: 60rem;
    }
  }

  .fane-ai__illustration {
    position: relative;
    width: 17rem;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 12px 40px rgb(249 115 22 / 0.15));
  }

  @media (min-width: 640px) {
    .fane-ai__illustration {
      width: 22rem;
    }
  }

  @media (min-width: 1024px) {
    .fane-ai__illustration {
      width: 26rem;
    }
  }

  /* Chat card */
  .fane-ai__chat {
    order: 3;
    display: flex;
    justify-content: center;
  }

  @media (min-width: 1024px) {
    .fane-ai__chat {
      justify-content: flex-end;
      padding-left: 0.5rem;
    }
  }

  .fane-ai__chat-card {
    width: 100%;
    max-width: 22rem;
    border-radius: 1.25rem;
    padding: 1.25rem;
    background: rgb(255 255 255);
    box-shadow:
      0 4px 6px rgb(37 37 43 / 0.04),
      0 20px 48px rgb(37 37 43 / 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .fane-ai__chat-card {
      max-width: 24rem;
      padding: 1.5rem;
    }
  }

  .fane-ai__message {
    border-radius: 1rem;
    padding: 0.875rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .fane-ai__message {
      font-size: 0.875rem;
    }
  }

  .fane-ai__message--ai {
    background: rgb(254 215 170 / 0.55);
    color: rgb(37 37 43);
    border-bottom-left-radius: 0.25rem;
    box-shadow: 0 2px 12px rgb(249 115 22 / 0.1);
  }

  .fane-ai__message--user {
    align-self: flex-end;
    max-width: 85%;
    background: rgb(255 255 255);
    color: rgb(37 37 43);
    border-bottom-right-radius: 0.25rem;
    box-shadow: 0 2px 14px rgb(37 37 43 / 0.08);
  }

  .fane-ai__message p {
    margin: 0;
  }

  .fane-ai__chat-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.25rem;
  }

  .fane-ai__stop-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border: none;
    border-radius: 9999px;
    background: rgb(247 247 248);
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    color: rgb(106 106 114);
    cursor: default;
  }
</style>
