---
import { Image } from 'astro:assets';
import { whyUsTabs } from '../../data/whyUsTabs';
---

<section
  id="why-us"
  class="bg-white-500 relative px-4 py-16 sm:px-6 sm:py-24"
  aria-labelledby="why-us-heading"
  data-why-us
>
  <div class="mx-auto max-w-6xl">
    <div class="mx-auto max-w-3xl text-center">
      <h2
        id="why-us-heading"
        class="text-black-500 text-[clamp(2.125rem,5.4vw,4rem)] leading-[1.1] font-semibold tracking-[-0.038em] text-balance"
      >
        De ce
        <span class="why-us-heading-fade">IziBook?</span>
      </h2>
      <p
        class="text-black-400 mx-auto mt-4 max-w-2xl text-[clamp(0.9375rem,2.2vw,1.0625rem)] leading-relaxed text-balance"
      >
        Stim ca sunt multe optiuni, dar niciuna completa. Fie ofera doar
        programari prin aplicatie fara statistici si rapoarte, fie ofera doar
        statistici si rapoarte fara programari, fie sunt disponibilite doar pe
        web fara aplicatie mobile. IziBook nu este doar "o aplicatie" este
        sistemul complet pentru afacerea ta. Disponibil pe toate platformele
        oferind o experienta completa pentru afacerea ta
      </p>
    </div>

    <div class="mt-10 flex justify-center sm:mt-12">
      <div
        class="why-us-tablist border-black-100 relative inline-flex w-full max-w-full flex-nowrap justify-center overflow-x-auto rounded-full border p-1 sm:w-auto sm:p-1.5"
        role="tablist"
        aria-label="De ce IziBook"
        data-why-us-tablist
      >
        <span
          class="why-us-tab-indicator"
          data-why-us-indicator
          aria-hidden="true"></span>
        {
          whyUsTabs.map((tab, index) => (
            <button
              type="button"
              role="tab"
              id={`why-us-tab-${tab.id}`}
              aria-controls={`why-us-panel-${tab.id}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              data-why-us-tab={tab.id}
              class:list={[
                'why-us-tab text-black-500/72 hover:text-black-500 focus-visible:outline-primary-500 relative z-1 min-w-0 flex-1 cursor-pointer rounded-full px-1 py-2.5 text-[0.6875rem] leading-tight font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 sm:flex-none sm:shrink-0 sm:px-3 sm:py-2.5 sm:text-sm sm:leading-normal md:px-4',
                index === 0 && 'is-active',
              ]}
            >
              {tab.label}
            </button>
          ))
        }
      </div>
    </div>

    <div
      class="why-us-slider relative mt-8 min-h-112 overflow-hidden rounded-4xl sm:mt-10 sm:min-h-144"
      data-why-us-slider
    >
      {
        whyUsTabs.map((tab, index) => (
          <div
            id={`why-us-panel-${tab.id}`}
            role="tabpanel"
            aria-labelledby={`why-us-tab-${tab.id}`}
            data-why-us-panel={tab.id}
            class:list={['why-us-panel', index === 0 && 'is-active']}
            hidden={index !== 0}
            aria-hidden={index !== 0 ? 'true' : 'false'}
          >
            <Image
              src={tab.image}
              alt={tab.imageAlt}
              title={tab.imageAlt}
              format="webp"
              quality={75}
              widths={[400, 640, 800, 1024, 1280]}
              sizes="(max-width: 1024px) calc(100vw - 2rem), 72rem"
              class="why-us-panel__image absolute inset-0 h-full w-full object-cover object-center"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
            <div
              class="from-black-900/85 via-black-700/35 to-black-500/10 absolute inset-0 bg-linear-to-t"
              aria-hidden="true"
            />
            <div class="why-us-panel__content relative flex min-h-112 flex-col justify-end p-6 sm:min-h-144 sm:p-10">
              <p class="why-us-panel__description text-white-500 max-w-lg text-base leading-relaxed sm:text-lg">
                {tab.description}
              </p>
              <div class="why-us-panel__stat mt-6 flex flex-wrap items-center gap-3">
                <span class="text-white-500 text-[clamp(2.5rem,6vw,4rem)] leading-none font-semibold tracking-tight">
                  {tab.stat}
                </span>
                <span class="text-white-500/80 text-sm font-medium sm:text-base">
                  {tab.statLabel}
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss">
  .why-us-heading-fade {
    display: block;
    background: linear-gradient(
      168deg,
      rgb(249 115 22) 0%,
      rgb(249 115 22 / 0.15) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .why-us-tablist {
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .why-us-tab-indicator {
    position: absolute;
    top: 0.25rem;
    left: 0;
    z-index: 0;
    height: calc(100% - 0.5rem);
    border-radius: 9999px;
    background: rgb(37 37 43);
    transform: translateX(0);
    transition:
      transform 0.38s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.38s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, width;

    @media (min-width: 640px) {
      top: 0.375rem;
      height: calc(100% - 0.75rem);
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .why-us-tab.is-active {
    color: rgb(255 255 255);
  }

  $panel-ease: cubic-bezier(0.22, 1, 0.36, 1);
  $panel-duration: 0.56s;

  .why-us-panel {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
  }

  .why-us-panel.is-active {
    z-index: 1;
    opacity: 1;
    pointer-events: auto;
  }

  .why-us-panel__image {
    transform: scale(1.04);
    transition: transform $panel-duration $panel-ease;
  }

  .why-us-panel.is-active .why-us-panel__image {
    transform: scale(1);
  }

  .why-us-panel__description,
  .why-us-panel__stat {
    opacity: 0;
    transform: translateY(1.25rem);
    transition:
      opacity 0.45s $panel-ease,
      transform 0.45s $panel-ease;
  }

  .why-us-panel__stat {
    transition-delay: 0.08s;
  }

  .why-us-panel.is-active .why-us-panel__description,
  .why-us-panel.is-active .why-us-panel__stat {
    opacity: 1;
    transform: translateY(0);
  }

  .why-us-slider.is-animating .why-us-panel.is-entering,
  .why-us-slider.is-animating .why-us-panel.is-leaving {
    transition:
      opacity $panel-duration $panel-ease,
      transform $panel-duration $panel-ease;
  }

  .why-us-slider.is-animating .why-us-panel {
    transition: opacity $panel-duration $panel-ease;
  }

  .why-us-slider.is-animating .why-us-panel__image {
    transition: transform $panel-duration $panel-ease;
  }

  .why-us-slider.is-animating .why-us-panel.is-entering.is-forward {
    transform: translateX(2.75rem);
  }

  .why-us-slider.is-animating .why-us-panel.is-entering.is-backward {
    transform: translateX(-2.75rem);
  }

  .why-us-slider.is-animating .why-us-panel.is-entering.is-active {
    transform: translateX(0);
  }

  .why-us-slider.is-animating .why-us-panel.is-leaving.is-forward {
    transform: translateX(-2.25rem);
    opacity: 0;
  }

  .why-us-slider.is-animating .why-us-panel.is-leaving.is-backward {
    transform: translateX(2.25rem);
    opacity: 0;
  }

  .why-us-slider.is-animating .why-us-panel.is-entering.is-active {
    opacity: 1;
  }

  .why-us-slider.is-animating .why-us-panel.is-leaving {
    z-index: 0;
  }

  .why-us-slider.is-animating .why-us-panel.is-entering {
    z-index: 2;
  }

  @media (prefers-reduced-motion: reduce) {
    .why-us-panel__image,
    .why-us-panel__description,
    .why-us-panel__stat,
    .why-us-slider.is-animating .why-us-panel {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  import { initWhyUs } from './initWhyUs';

  document.querySelectorAll<HTMLElement>('[data-why-us]').forEach((root) => {
    initWhyUs(root);
  });
</script>
