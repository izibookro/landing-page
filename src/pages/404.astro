---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/footer/Footer.astro';

Astro.response.status = 404;
---

<BaseLayout
  title="Pagina nu a fost gasita"
  description="Pagina pe care o cauti nu exista sau a fost mutata. Intoarce-te la pagina principala IziBook."
  canonicalPath="/404"
  noindex
>
  <Navbar />
  <main class="flex min-h-[70vh] flex-col items-center justify-center px-4 py-24 text-center">
    <p class="text-primary-500 text-sm font-bold tracking-wide uppercase">Eroare 404</p>
    <h1 class="text-black-500 mt-3 max-w-xl text-3xl font-black sm:text-4xl">
      Pagina nu a fost gasita
    </h1>
    <p class="text-black-400 mt-4 max-w-md text-base leading-relaxed">
      Linkul poate fi vechi sau incorect. Continua de pe pagina principala sau din blog.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        title="Inapoi la pagina principala IziBook"
        class="bg-primary-700 hover:bg-primary-800 focus-visible:outline-primary-500 inline-flex rounded-full px-6 py-3 text-sm font-bold text-white no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Inapoi acasa
      </a>
      <a
        href="/blog"
        title="Vezi blogul IziBook"
        class="bg-black-50 text-black-500 hover:bg-black-100 focus-visible:outline-primary-500 inline-flex rounded-full px-6 py-3 text-sm font-bold no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Vezi blogul
      </a>
      <a
        href="/#preturi"
        title="Vezi preturile IziBook"
        class="bg-black-50 text-black-500 hover:bg-black-100 focus-visible:outline-primary-500 inline-flex rounded-full px-6 py-3 text-sm font-bold no-underline transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Preturi
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
