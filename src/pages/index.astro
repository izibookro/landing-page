---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/hero/Hero.astro';
import FeaturesCarousel from '../components/features/FeaturesCarousel.astro';
import FaneAI from '../components/ai-assistant/FaneAI.astro';
import ManagerNeedsSection from '../components/manager-needs/ManagerNeedsSection.astro';
import WhyUsSection from '../components/why-us/WhyUsSection.astro';
import PlansSection from '../components/plans/PlansSection.astro';
import FaqSection from '../components/faq/FaqSection.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import BlogSection from '../components/blog/BlogSection.astro';
import DownloadSection from '../components/download/DownloadSection.astro';
import AppShowcase from '../components/app-showcase/AppShowcase.astro';
import Footer from '../components/footer/Footer.astro';
---

<BaseLayout includeFaq faqScope="home">
  <Navbar />
  <main>
    <Hero />
    <FeaturesCarousel />
    <AppShowcase />
    <FaneAI />
    <ManagerNeedsSection />
    <WhyUsSection />
    <PlansSection />
    <FaqSection />
    <ContactSection />
    <BlogSection />
    <DownloadSection />
  </main>
  <Footer />
</BaseLayout>
