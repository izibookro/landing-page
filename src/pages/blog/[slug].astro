---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/footer/Footer.astro';
import BlogPostSidebar from '../../components/blog/BlogPostSidebar.astro';
import BlogPostToc from '../../components/blog/BlogPostToc.astro';
import DownloadSection from '../../components/download/DownloadSection.astro';
import {
  extractTocEntries,
  formatBlogPostDate,
  getBlogReadTime,
  getRelatedPostsByCategory,
} from '../../lib/blog';
import { getBlogAuthor } from '../../data/blogAuthors';
import { getImage, Image, Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { site } from '../../data/site';
import '../../components/blog/blog-post.scss';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const tocEntries = extractTocEntries(post.body ?? '');
const readTime = getBlogReadTime(post);
const relatedPosts = await getRelatedPostsByCategory(post, 3);
const author = getBlogAuthor();
const canonicalPath = `/blog/${post.id}`;
const publishedTime = post.data.pubDate.toISOString();

const shareUrl = new URL(canonicalPath, Astro.site ?? site.url).href;

const authorImage = await getImage({
  src: author.avatar,
  width: 256,
  height: 256,
  format: 'webp',
});
const authorImageUrl = new URL(authorImage.src, Astro.site ?? site.url).href;

const ogImage = await getImage({
  src: post.data.image,
  width: 1200,
  height: 630,
  format: 'jpg',
  fit: 'cover',
});
const ogImageUrl = new URL(ogImage.src, Astro.site ?? site.url).href;
const imageAlt = post.data.imageAlt ?? post.data.title;
const imageTitle = post.data.imageTitle ?? post.data.title;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={canonicalPath}
  type="article"
  image={ogImageUrl}
  imageAlt={imageAlt}
  article={{
    publishedTime,
    modifiedTime: publishedTime,
    authorName: author.name,
    authorJobTitle: author.jobTitle,
    authorImage: authorImageUrl,
    section: post.data.category,
  }}
  breadcrumbs={[
    { name: 'Acasa', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: post.data.title, path: canonicalPath },
  ]}
>
  <Navbar />
  <a
    href="#blog-post-content"
    title="Sari la continutul articolului"
    class="blog-post__skip-link"
  >
    Sari la continutul articolului
  </a>
  <main class="bg-white-500 min-h-screen pt-28 pb-16 sm:pt-32 sm:pb-24">
    <article class="px-4 sm:px-6" aria-labelledby="blog-post-title">
      <div class="blog-post__shell mx-auto max-w-340">
        <div class="blog-post__grid">
          <aside class="blog-post__toc-col">
            <a
              href="/"
              title="Inapoi la pagina principala IziBook"
              class="blog-post__back-btn text-black-500 bg-white-500 focus-visible:outline-primary-500 inline-flex cursor-pointer items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold no-underline shadow-[0_2px_16px_rgb(37_37_43/0.08)] transition-[box-shadow,transform] duration-200 hover:-translate-y-px hover:shadow-[0_4px_24px_rgb(37_37_43/0.12)] focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              <Icon
                name="solar:arrow-left-linear"
                class="size-4"
                aria-hidden="true"
              />
              Pagina principala
            </a>

            {
              tocEntries.length > 0 && (
                <BlogPostToc entries={tocEntries} variant="desktop" />
              )
            }
          </aside>

          <div class="blog-post__main">
            <header class="blog-post__intro">
              <h1
                id="blog-post-title"
                class="text-black-500 text-[clamp(2rem,4.8vw,3rem)] leading-[1.1] font-semibold tracking-[-0.035em] text-balance"
              >
                {post.data.title}
              </h1>

              <p
                class="text-black-400 mt-4 max-w-2xl text-[clamp(1rem,2.2vw,1.125rem)] leading-relaxed text-pretty"
              >
                {post.data.description}
              </p>

              <div class="blog-post__byline mt-6">
                <Image
                  src={author.avatar}
                  alt={author.avatarAlt}
                  title={author.avatarTitle}
                  format="webp"
                  widths={[80, 160]}
                  sizes="40px"
                  class="blog-post__byline-avatar size-10 rounded-full object-cover"
                  loading="eager"
                  decoding="async"
                />
                <div class="min-w-0">
                  <p class="text-black-500 text-sm font-bold">
                    {author.name}
                  </p>
                  <p class="text-black-400 text-sm">{author.jobTitle}</p>
                  <div
                    class="text-black-400 mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
                  >
                    <span class="inline-flex items-center gap-1">
                      <Icon
                        name="solar:calendar-minimalistic-linear"
                        class="size-3.5"
                        aria-hidden="true"
                      />
                      {formatBlogPostDate(post.data.pubDate)}
                    </span>
                    <span aria-hidden="true">·</span>
                    <span class="inline-flex items-center gap-1">
                      <Icon
                        name="solar:clock-circle-linear"
                        class="size-3.5"
                        aria-hidden="true"
                      />
                      {readTime}
                    </span>
                  </div>
                </div>
              </div>
            </header>

            <div
              class="blog-post__hero relative mt-8 overflow-hidden rounded-4xl"
            >
              <Picture
                src={post.data.image}
                alt={imageAlt}
                title={imageTitle}
                formats={['avif', 'webp']}
                widths={[640, 960, 1280, 1600]}
                sizes="(max-width: 1024px) 92vw, 760px"
                layout="constrained"
                class="aspect-16/10 w-full object-cover"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
            </div>

            {
              tocEntries.length > 0 && (
                <BlogPostToc entries={tocEntries} variant="mobile" />
              )
            }

            <div
              id="blog-post-content"
              tabindex="-1"
              class="blog-post__panel from-white-700 via-black-50 to-black-100 blog-post__prose mt-8 rounded-4xl bg-linear-to-br from-0% via-42% to-100% p-6 sm:mt-10 sm:p-8 lg:rounded-[2.25rem] lg:p-10"
            >
              <Content />
            </div>
          </div>

          <BlogPostSidebar
            author={author}
            relatedPosts={relatedPosts}
            shareUrl={shareUrl}
            shareTitle={post.data.title}
          />
        </div>
      </div>
    </article>

    <DownloadSection />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { initBlogPostPage } from '../../components/blog/initBlogPostPage';

  const cleanup = initBlogPostPage();

  document.addEventListener('astro:before-swap', () => cleanup(), {
    once: true,
  });
</script>
