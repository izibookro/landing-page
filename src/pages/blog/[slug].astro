---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/footer/Footer.astro';
import BlogPostSidebar from '../../components/blog/BlogPostSidebar.astro';
import {
  extractHeadings,
  formatBlogPostDate,
  getBlogReadTime,
  getRelatedPostsByCategory,
} from '../../lib/blog';
import { getBlogAuthor } from '../../data/blogAuthors';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import '../../components/blog/blog-post.scss';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const headings = extractHeadings(post.body ?? '');
const readTime = getBlogReadTime(post);
const relatedPosts = await getRelatedPostsByCategory(post, 3);
const author = getBlogAuthor();

const shareUrl = new URL(`/blog/${post.id}`, Astro.site ?? 'https://izibook.ro')
  .href;
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}`}
>
  <Navbar />
  <main class="bg-white-500 min-h-screen pt-28 pb-16 sm:pt-32 sm:pb-24">
    <article class="px-4 sm:px-6" aria-labelledby="blog-post-title">
      <div class="blog-post__shell mx-auto max-w-[85rem]">
        <div class="blog-post__grid">
          <aside class="blog-post__toc-col">
            <a
              href="/blog"
              class="blog-post__back-btn bg-black-500 text-white-500 hover:bg-black-600 inline-flex w-fit cursor-pointer items-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold no-underline transition-[background-color,box-shadow,transform] duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
            >
              <Icon
                name="solar:arrow-left-linear"
                class="size-4"
                aria-hidden="true"
              />
              Inapoi la blog
            </a>

            {
              headings.length > 0 && (
                <nav
                  class="blog-post__toc"
                  aria-label="Cuprins articol"
                  data-blog-toc
                >
                  <p class="blog-post__toc-title">
                    <Icon
                      name="solar:list-check-linear"
                      class="size-5.5 shrink-0 text-primary-500"
                      aria-hidden="true"
                    />
                    Cuprins
                  </p>
                  <ol class="blog-post__toc-list">
                    {headings.map((heading, index) => (
                      <li
                        class:list={[
                          'blog-post__toc-item',
                          heading.depth === 3 &&
                            'blog-post__toc-item--depth-3',
                        ]}
                      >
                        <a
                          href={`#${heading.id}`}
                          class="blog-post__toc-link"
                          data-toc-link={heading.id}
                        >
                          <span class="blog-post__toc-index">
                            {String(index + 1).padStart(2, '0')}
                          </span>
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ol>
                </nav>
              )
            }
          </aside>

          <div class="blog-post__main">
            <header class="blog-post__intro">
              <h1
                id="blog-post-title"
                class="text-black-500 text-[clamp(2rem,4.8vw,3rem)] leading-[1.1] font-semibold tracking-[-0.035em] text-balance"
              >
                {post.data.title}
              </h1>

              <p
                class="text-black-400 mt-4 max-w-2xl text-[clamp(1rem,2.2vw,1.125rem)] leading-relaxed text-pretty"
              >
                {post.data.description}
              </p>

              <div class="blog-post__byline mt-6">
                <Image
                  src={author.avatar}
                  alt=""
                  class="blog-post__byline-avatar size-10 rounded-full object-cover"
                  loading="eager"
                  decoding="async"
                />
                <div class="min-w-0">
                  <p class="text-black-500 text-sm font-bold">
                    {author.name}
                  </p>
                  <div
                    class="text-black-400 mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
                  >
                    <span class="inline-flex items-center gap-1">
                      <Icon
                        name="solar:calendar-minimalistic-linear"
                        class="size-3.5"
                        aria-hidden="true"
                      />
                      {formatBlogPostDate(post.data.pubDate)}
                    </span>
                    <span aria-hidden="true">·</span>
                    <span class="inline-flex items-center gap-1">
                      <Icon
                        name="solar:clock-circle-linear"
                        class="size-3.5"
                        aria-hidden="true"
                      />
                      {readTime}
                    </span>
                  </div>
                </div>
              </div>
            </header>

            <div class="blog-post__hero relative mt-8 overflow-hidden rounded-4xl">
              <Image
                src={post.data.image}
                alt={post.data.title}
                class="aspect-16/10 w-full object-cover"
                loading="eager"
                decoding="async"
              />
            </div>

            <div
              class="blog-post__panel from-white-700 via-black-50 to-black-100 blog-post__prose mt-8 rounded-4xl bg-linear-to-br from-0% via-42% to-100% p-6 sm:mt-10 sm:p-8 lg:rounded-[2.25rem] lg:p-10"
            >
              <Content />
            </div>
          </div>

          <BlogPostSidebar
            author={author}
            relatedPosts={relatedPosts}
            shareUrl={shareUrl}
            shareTitle={post.data.title}
          />
        </div>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>

<script>
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  const headingIds = [...tocLinks].map((link) => link.dataset.tocLink).filter(Boolean);

  if (headingIds.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          tocLinks.forEach((link) => {
            link.classList.toggle(
              'is-active',
              link.dataset.tocLink === entry.target.id,
            );
          });
        });
      },
      { rootMargin: '-20% 0px -70% 0px', threshold: 0 },
    );

    headingIds.forEach((id) => {
      const heading = document.getElementById(id!);
      if (heading) observer.observe(heading);
    });

    document.addEventListener(
      'astro:before-swap',
      () => observer.disconnect(),
      { once: true },
    );
  }
</script>
