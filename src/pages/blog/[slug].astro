---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/footer/Footer.astro';
import { formatBlogDate } from '../../lib/blog';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import '../../components/blog/blog-post.scss';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const relatedPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .filter((entry) => entry.id !== post.id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonicalPath={`/blog/${post.id}`}
>
  <Navbar />
  <main class="bg-white-500 min-h-screen pt-28 pb-16 sm:pt-32 sm:pb-24">
    <article class="px-4 sm:px-6" aria-labelledby="blog-post-title">
      <div class="mx-auto max-w-4xl">
        <a
          href="/blog"
          class="blog-post__back inline-flex items-center gap-2 text-sm font-medium no-underline transition-colors duration-200"
        >
          <Icon
            name="solar:alt-arrow-left-linear"
            class="size-4"
            aria-hidden="true"
          />
          Inapoi la blog
        </a>

        <header class="mt-6">
          <div class="relative overflow-hidden rounded-4xl">
            <Image
              src={post.data.image}
              alt={post.data.title}
              class="aspect-16/10 w-full object-cover"
              loading="eager"
              decoding="async"
            />
            <span
              class="blog-post__category absolute bottom-5 left-5 rounded-full px-3.5 py-1.5 text-xs font-semibold sm:bottom-6 sm:left-6"
            >
              {post.data.category}
            </span>
          </div>

          <h1
            id="blog-post-title"
            class="text-black-500 mt-8 text-[clamp(2rem,4.8vw,3.25rem)] leading-[1.08] font-semibold tracking-[-0.035em] text-balance"
          >
            {post.data.title}
          </h1>

          <div
            class="text-black-400 mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm sm:text-base"
          >
            <span class="inline-flex items-center gap-1.5">
              <Icon
                name="solar:calendar-minimalistic-linear"
                class="size-4.5"
                aria-hidden="true"
              />
              {formatBlogDate(post.data.pubDate)}
            </span>
            <span class="inline-flex items-center gap-1.5">
              <Icon
                name="solar:clock-circle-linear"
                class="size-4.5"
                aria-hidden="true"
              />
              {post.data.readTime}
            </span>
          </div>
        </header>

        <div
          class="blog-post__panel from-white-700 via-black-50 to-black-100 blog-post__prose mt-8 rounded-4xl bg-linear-to-br from-0% via-42% to-100% p-6 sm:mt-10 sm:p-8 lg:rounded-[2.25rem] lg:p-10"
        >
          <Content />
        </div>

        {
          relatedPosts.length > 0 && (
            <aside class="mt-10 sm:mt-12" aria-labelledby="related-posts-heading">
              <h2
                id="related-posts-heading"
                class="text-black-500 text-xl font-semibold tracking-tight sm:text-2xl"
              >
                Alte articole
              </h2>
              <ul class="mt-4 space-y-3">
                {relatedPosts.map((relatedPost) => (
                  <li>
                    <a
                      href={`/blog/${relatedPost.id}`}
                      class="text-black-400 hover:text-primary-500 text-base no-underline transition-colors duration-200"
                    >
                      {relatedPost.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
