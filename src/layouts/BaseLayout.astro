---
import { Font } from 'astro:assets';
import appIcon from '../assets/icon.png';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Izibook — Salon Booking & Management',
  description = 'Manage appointments, clients, and revenue — all in one place.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Font cssVariable="--font-roboto" preload />
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={appIcon.src} />
    <link rel="apple-touch-icon" href={appIcon.src} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>

  <body class="bg-white-500 font-sans text-black-500 antialiased">
    <slot />
  </body>
</html>
