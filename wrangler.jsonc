{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "izibook-landing",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    // Serve dist/404.html with HTTP 404 for unknown routes (no SPA soft-404).
    "not_found_handling": "404-page",
    // Match Astro trailingSlash: 'never' + canonicals (no slash except `/`).
    // Default auto-trailing-slash would 307 /blog → /blog/ and conflict with canonicals.
    "html_handling": "drop-trailing-slash"
  }
}
